generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum WebhookSource {
  HUBSPOT
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

/// Durable record of every inbound webhook. Doubles as the idempotency ledger:
/// the unique (source, externalId) constraint makes redelivery a no-op.
model WebhookEvent {
  id         String             @id @default(uuid())
  source     WebhookSource
  externalId String // provider's event id (HubSpot `eventId`)
  eventType  String // e.g. HubSpot `subscriptionType`
  payload    Json
  status     WebhookEventStatus @default(RECEIVED)
  attempts   Int                @default(0)
  error      String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([source, externalId])
  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(EMPLOYEE)

  createdExpenses  Expense[] @relation("CreatedExpenses")
  approvedExpenses Expense[] @relation("ApprovedExpenses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String        @id @default(uuid())
  title       String
  description String?
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("DKK")
  category    String
  status      ExpenseStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("CreatedExpenses", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedExpenses", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
